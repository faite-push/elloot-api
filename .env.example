# Copy to .env and/or .env.local
# Priority: .env.local overrides .env

# Server
PORT=3333
NODE_ENV=development
APP_URL=http://localhost:3333
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# PostgreSQL
# Local: docker compose (no SSL)
# Square Cloud: connection URL + certificate.pem from dashboard
# Docs: https://docs.squarecloud.app/pt-br/services/databases
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/elloot?schema=public
# DATABASE_SSL_CERT_PATH=./src/databases/postgres/certificates/certificate.pem
# DATABASE_SSL_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# ---------------------------------------------------------------------------
# Redis
# Local: redis://localhost:6379
# Square Cloud: rediss://... + certificate under redis/certificates
# ---------------------------------------------------------------------------
# Leave REDIS_URL empty to run without Redis (checkout reserve uses DB only)
# REDIS_URL=redis://localhost:6379
# REDIS_SSL_CERT_PATH=./src/databases/redis/certificates/certificate.pem
# REDIS_SSL_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Auth
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=7d

# OAuth (optional — leave empty to disable a provider)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Google redirect URI to register:
#   {APP_URL}/api/auth/google/callback
# Discord redirect URI to register:
#   {APP_URL}/api/auth/discord/callback

# Platform
PLATFORM_FEE_BPS=1000
ESCROW_AUTO_RELEASE_HOURS=48
PAYMENT_PROVIDER=sandbox
CHECKOUT_RESERVE_SECONDS=900
# Optional. Required to enable POST /api/payments/sandbox/webhook
# SANDBOX_WEBHOOK_SECRET=long-random-secret
# Header: x-sandbox-webhook-secret: <SANDBOX_WEBHOOK_SECRET>

# Background jobs (expire checkout + auto-release escrow)
# JOB_SECRET=long-random-secret
# Header: x-job-secret: <JOB_SECRET>
# Or call /api/jobs/* with ADMIN JWT
JOB_POLL_MS=60000

# ---------------------------------------------------------------------------
# Media CDN
# local = disk under MEDIA_LOCAL_DIR (dev)
# s3 = S3 / Cloudflare R2 / MinIO (production)
# ---------------------------------------------------------------------------
MEDIA_DRIVER=local
MEDIA_LOCAL_DIR=./storage/media
# Optional public CDN base (R2 custom domain / CloudFront). Empty = API serves /api/media/:id/content
# MEDIA_PUBLIC_BASE_URL=https://cdn.elloot.com
MEDIA_MAX_BYTES=5242880
# Defaults to JWT_SECRET if empty
# MEDIA_SIGNING_SECRET=
MEDIA_SIGN_TTL_SECONDS=900

# S3 / R2 (required when MEDIA_DRIVER=s3)
# MEDIA_S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# MEDIA_S3_REGION=auto
# MEDIA_S3_BUCKET=elloot-media
# MEDIA_S3_ACCESS_KEY_ID=
# MEDIA_S3_SECRET_ACCESS_KEY=
# MEDIA_S3_FORCE_PATH_STYLE=true

# Seed: GGMAX category cover images (filename from API → this base)
# GGMAX_CATEGORY_MEDIA_BASE=https://cdn.ggmax.com.br/category-images

